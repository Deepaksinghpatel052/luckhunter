# =============================================================
# .env.example — copy to .env and fill in real values.
# .env is git-ignored and must never be committed.
# =============================================================

# ---- Django core ----
# Generate a unique value per environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret

# True for local development, False in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames. '*' is fine for local dev only.
# Production example: luckhunter.in,www.luckhunter.in
DJANGO_ALLOWED_HOSTS=*

# Public base URL used to build absolute links (redirects, callback URLs).
# Dev example:  http://127.0.0.1:8000/
# Prod example: https://luckhunter.in/
BASE_URL=http://127.0.0.1:8000/

# ---- Database ----
# Leave DB_ENGINE unset/blank to use local SQLite (dev default, zero config).
# Uncomment and set these to switch to PostgreSQL in production:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=luckhunter
# DB_USER=luckhunter
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# ---- Email (SMTP) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
# Use a Gmail "App Password", never the real account password.
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=change-me

# ---- Stripe ----
# Use pk_test_/sk_test_ keys in development, pk_live_/sk_live_ in production.
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder

# ---- Paytm (deactivated) ----
# PayTm checkout is no longer wired into urls.py / the front-end (replaced by
# Razorpay). paytm_payment app/models/migrations are kept so past payment
# history (LsPayments, LsPaytm_credentials) stays intact and queryable.
# PAYTM_GATEWAY_URL=https://securegw-stage.paytm.in/order/process
# PAYTM_GATEWAY_URL=https://securegw.paytm.in/order/process

# ---- Razorpay ----
# Use rzp_test_ keys in development, rzp_live_ keys in production.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=change-me
